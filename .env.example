LINE_CHANNEL_ACCESS_TOKEN=
# Existing Render name CHANNEL_ACCESS_TOKEN is also supported; no need to copy its value into code.
LINE_CHANNEL_SECRET=
LINE_ALLOWED_USER_IDS=
FINANCE_SYNC_TOKEN=
# Keep the existing value in Render; never copy a service-account key into the repository.
FIREBASE_SERVICE_ACCOUNT=
# Required for Render. File storage is only for local tests or a separately managed durable disk.
FINANCE_STORAGE=firestore
DATA_DIR=./data
# Replies are disabled until enabled by the owner.
LINE_REPLY_ENABLED=false
# Optional compatibility with the original Claude image analysis:
LEGACY_ANALYSIS_ENABLED=false
ANTHROPIC_API_KEY=
# Existing Render name CLAUDE_API_KEY is also supported when legacy analysis is explicitly enabled.
ANTHROPIC_MODEL=
PORT=3000
